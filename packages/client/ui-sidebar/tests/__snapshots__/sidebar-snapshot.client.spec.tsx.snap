          </span>
        </span>
      </button>
      <button
        aria-label="播放小猫动画"
        aria-pressed="false"
        class="brandCat"
        type="button"
      >
        <picture>
          <img
            alt="小猫休息中"
            data-cat-state="sleeping"
            height="32"
