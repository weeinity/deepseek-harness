        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="d95b7908"
          data-icon="dsw-icon-panel-left-outline-regular"
          height="16"
          width="16"
        />
      </button>
    </div>
    <button
      aria-label="新建会话"
