// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows collapsed 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root collapsed railIn quietBars"
    style=""
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="Play cat animation"
        aria-pressed="false"
        class="brandCat"
        hidden=""
        type="button"
      >
        <picture>
          <img
            alt="Cat sleeping"
            data-cat-state="sleeping"
            height="32"
            hidden=""
            src="data:image/webp;base64,"
            width="40"
          />
        </picture>
      </button>
      <button
        aria-label="Open sidebar"
        class="iconButton toggle"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="d95b7908"
          data-icon="dsw-icon-panel-left-outline-regular"
          height="16"
          width="16"
        />
        <div
          data-slot="sidebar.toggle.badge"
          style="display: contents;"
        />
      </button>
    </div>
    <button
      aria-label="New session"
      class="newSession"
      type="button"
    >
      <span
        class="newSessionLabelMask"
      >
        <span
          class="newSessionContent"
        >
          <svg
            aria-hidden="true"
            data-content="6e5e38f3"
            data-icon="dsw-icon-new-chat-outline-regular"
            height="16"
            width="16"
          />
        </span>
      </span>
    </button>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows expanded 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 300px;"
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="New session"
        class="brand wide"
        type="button"
      >
        <span
          aria-hidden="true"
          class="brandIdentity"
        >
          <span
            class="brandMark"
          >
            <div
              data-slot="sidebar.brand.mark"
              style="display: contents;"
            >
              <span
                class="copyVersion"
                data-copy-version="true"
              >
                <svg
                  aria-hidden="true"
                  data-brand="mip-autolabeling"
                  data-content="abc2f626"
                  fill="none"
                  focusable="false"
                  height="24"
                  viewBox="0 0 512 512"
                  width="24"
                />
              </span>
            </div>
          </span>
          <span
            class="brandName"
          >
            <div
              data-slot="sidebar.brand.name"
              style="display: contents;"
            >
              <span
                class="fallbackBrandName copyVersion"
                data-copy-version="true"
              >
                MIP Autolabeling
              </span>
            </div>
          </span>
        </span>
      </button>
      <button
        aria-label="Play cat animation"
        aria-pressed="false"
        class="brandCat"
        type="button"
      >
        <picture>
          <img
            alt="Cat sleeping"
            data-cat-state="sleeping"
            height="32"
            src="data:image/webp;base64,"
            width="40"
          />
        </picture>
      </button>
      <button
        aria-label="Collapse sidebar"
        class="iconButton toggle"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="d95b7908"
          data-icon="dsw-icon-panel-left-outline-regular"
          height="16"
          width="16"
        />
      </button>
    </div>
    <button
      aria-label="New session"
      class="newSession"
      type="button"
    >
      <span
        class="newSessionLabelMask"
      >
        <span
          class="newSessionContent"
        >
          <svg
            aria-hidden="true"
            data-content="532cf99a"
            data-icon="dsw-icon-new-chat-outline-medium"
            height="14"
            width="14"
          />
          <span
            class="newSessionLabel wide"
          >
            New Session
          </span>
        </span>
      </span>
    </button>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

