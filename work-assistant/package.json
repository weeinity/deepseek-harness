{
  "name": "@deepseek-ai/dsh-work-assistant-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:receipt-runtime": "node ./scripts/build-receipt-runtime.mjs",
    "setup:profile": "node ./scripts/setup-personal-assistant.mjs",
    "test": "vitest run",
    "test:profile": "node ./profile-tests/profile-smoke.mjs",
    "typecheck": "tsc -p tsconfig.check.json && pnpm --filter @deepseek-ai/dsh-wa-ui run typecheck"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-credentials-local": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-storage": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-storage-sqlite": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-wa-preset": "workspace:*",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.8",
    "croner": "10.0.1",
    "playwright": "1.61.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
