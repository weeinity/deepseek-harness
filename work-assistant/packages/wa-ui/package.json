{
  "name": "@deepseek-ai/dsh-wa-ui",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Personal-assistant web UI panel for the DSH work-assistant profile",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/config.js",
    "lib/config.d.ts",
    "lib/receipt-policy.js",
    "lib/receipt-policy.d.ts",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client-types && pnpm run bundle:client",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client-types": "tsc -p tsconfig.client.json",
    "bundle:client": "tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-wa-briefing": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "immer": "10.2.0",
    "jsdom": "29.1.1",
    "lightningcss": "^1.29.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "zustand": "4.4.7"
  }
}
