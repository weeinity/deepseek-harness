{
  "name": "dsh-llm-oauth",
  "description": "DeepSeek Harness plugin: OAuth / subscription-plan LLM providers (Grok, GitHub Copilot, OpenAI Codex, Anthropic, OpenRouter)",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsdown --config tsdown.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "login": "node bin/login.mjs",
    "prepare": "node ./scripts/prepare.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "bin": {
    "dsh-llm-oauth-login": "./bin/login.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "src",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "oauth",
    "grok",
    "xai",
    "github-copilot",
    "openai-codex",
    "anthropic",
    "openrouter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyou979/dsh-llm-oauth.git"
  },
  "homepage": "https://github.com/ziyou979/dsh-llm-oauth",
  "bugs": {
    "url": "https://github.com/ziyou979/dsh-llm-oauth/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "link:../../vendor/schemastery",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.30.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@deepseek-ai/cordis": "link:../../vendor/cordis",
    "@deepseek-ai/dsh-attachment": "link:../../packages/attachment/attachment",
    "@deepseek-ai/dsh-client-connection": "link:../../packages/client/connection",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../packages/client/ui-renderer",
    "@deepseek-ai/dsh-fs": "link:../../packages/fs/fs",
    "@deepseek-ai/dsh-host-webserver": "link:../../packages/host/webserver",
    "@deepseek-ai/dsh-llm": "link:../../packages/llm/llm",
    "@deepseek-ai/dsh-settings": "link:../../packages/settings/settings",
    "@deepseek-ai/dsh-util-values": "link:../../packages/util/values",
    "@deepseek-ai/cordis-plugin-loader": "link:../../vendor/loader",
    "@deepseek-ai/dsh-app-boot": "link:../../packages/boot/app-boot",
    "@deepseek-ai/dsh-config-editor": "link:../../packages/boot/config-editor",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../packages/client/ui-slots",
    "@deepseek-ai/dsh-client-locale": "link:../../packages/client/locale"
  }
}
